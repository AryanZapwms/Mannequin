# =============================================================================
# Mannequin Care — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB — connection string (Atlas or self-hosted, replica-set mode required
# for transactions used in order creation)
# -----------------------------------------------------------------------------

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mannequincare

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5) — https://authjs.dev
# -----------------------------------------------------------------------------

# Random secret used to sign/encrypt session JWTs and cookies.
# Generate with: npx auth secret
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical URL of the app (used for callback/redirect URLs)
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings/api-keys
# -----------------------------------------------------------------------------

# Cloud name is safe to expose to the browser (used to build delivery URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name

# API key/secret — SERVER-SIDE ONLY, used to sign uploads and deletions
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Razorpay — https://dashboard.razorpay.com/app/keys
# -----------------------------------------------------------------------------

# Key ID is safe to expose to the browser (used in Razorpay.js checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Same key id, read server-side when creating orders via the Razorpay SDK
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Key Secret — SERVER-SIDE ONLY, used to verify payment signatures
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook secret — set the same value in the Razorpay dashboard when adding the
# webhook for https://<your-domain>/api/razorpay/webhook
# Subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Email (Nodemailer via Gmail App Password)
# Create an App Password at https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------

# Gmail address used to send transactional emails
GMAIL_EMAIL=your-store-email@gmail.com

# 16-character App Password generated in your Google account
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public base URL of your deployed site (no trailing slash)
NEXT_PUBLIC_APP_URL=https://mannequincare.in

# For local development use:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
